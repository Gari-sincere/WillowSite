---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Google Fonts `family=` query fragments, e.g. ["Nunito:wght@400;700"] */
  fonts?: string[];
  /** Classes applied to <body> (page-level font + colours). */
  bodyClass?: string;
  /** Theme colour for mobile browser chrome. */
  themeColor?: string;
}

const {
  title,
  description,
  fonts = [],
  bodyClass = "",
  themeColor = "#f9f1ea",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fontHref = fonts.length
  ? `https://fonts.googleapis.com/css2?${fonts.map((f) => `family=${f}`).join("&")}&display=swap`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <link rel="preload" as="image" href={`${base}hero-poster.jpg`} />
    {fontHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontHref} />
      </>
    )}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
