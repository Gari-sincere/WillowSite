---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import HeroVideo from "../components/HeroVideo.astro";

const faqs = [
  {
    q: "How big does a company need to be?",
    a: "Our clients have between about ten and two hundred people. Below that, you probably don't need us yet. Above that, you should have someone in-house, and we can help you hire them.",
  },
  {
    q: "Do you sell hardware or licences?",
    a: "No. We'll tell you what to buy and help you buy it, but the invoice comes from the vendor, not from us. That keeps the advice honest.",
  },
  {
    q: "Who owns the software you build?",
    a: "You do. Source code, accounts, documentation, all of it. We keep a copy so we can support it, and we'll hand everything to another team if you ever want to move.",
  },
  {
    q: "What does it cost?",
    a: "Support is a fixed monthly fee per person. Software and consulting are quoted as a fixed price for a written scope. Every proposal has the number on the first page.",
  },
  {
    q: "What happens after a project ends?",
    a: "Usually we stay on for support and small changes at the monthly rate. Some clients don't need that and just call us the next time something comes up. Both are fine.",
  },
];
---

<Layout
  title="Willow — IT, software, and advice, in plain language"
  description="Willow is a small technology company. We fix the IT, build the software, and advise on the rest, for companies with ten to two hundred people."
  fonts={["Familjen+Grotesk:ital,wght@0,400..700;1,400..700"]}
  bodyClass="font-familjen bg-cream text-forest antialiased"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-7">
    <a href="#top" aria-label="Willow, back to top" class="text-forest">
      <Logo variant="mark" class="h-10 w-auto" />
    </a>
    <div class="flex items-center gap-6 text-[15px]">
      <a href="#services" class="hidden hover:underline sm:inline">Services</a>
      <a href="#questions" class="hidden hover:underline sm:inline">Questions</a>
      <a href="#contact" class="rounded-md border border-forest px-3.5 py-1.5 font-medium hover:bg-forest hover:text-cream">Talk to us</a>
    </div>
  </nav>

  <main id="top">
    <!-- Hero: one sentence, with the film inside it -->
    <header class="mx-auto max-w-6xl px-6 pb-24 pt-14 text-center lg:pb-36 lg:pt-24">
      <h1 class="mx-auto max-w-[18ch] text-[clamp(2.4rem,6.6vw,6rem)] font-medium leading-[1.05] tracking-[-0.03em] text-balance">
        We fix the IT,
        <span class="relative mx-[0.08em] inline-block h-[0.84em] w-[2.5em] translate-y-[0.1em] overflow-hidden rounded-full bg-forest-deep align-baseline ring-[0.06em] ring-sage" aria-hidden="true">
          <HeroVideo class="absolute inset-0 h-full w-full object-cover" />
        </span>
        build the software, and advise on the rest.
      </h1>
      <p class="mx-auto mt-10 max-w-[48ch] text-lg leading-relaxed text-forest/80 sm:text-xl">
        Willow is a small technology company for businesses with ten to two hundred people. Three services, plain prices, the same people every time.
      </p>
      <div class="mt-10 flex items-center justify-center gap-6">
        <a href="#contact" class="rounded-md bg-forest px-6 py-3.5 text-[17px] font-medium text-cream hover:bg-forest-deep">Book a call</a>
        <a href="#services" class="text-[17px] underline decoration-sage decoration-2 underline-offset-4">How it works</a>
      </div>
    </header>

    <!-- Services as a definition list, narrow measure -->
    <section id="services" class="mx-auto max-w-3xl px-6 py-16 lg:py-20">
      <h2 class="text-3xl font-medium tracking-tight">Three services</h2>
      <dl class="mt-10 space-y-12">
        <div>
          <dt class="text-2xl font-medium">Managed IT</dt>
          <dd class="mt-3 text-lg leading-relaxed text-forest/85">
            We take care of the technology that everyone uses and nobody owns: laptops, accounts, email, the network, backups, security. It's a fixed monthly fee per person. You get a phone number, a named engineer, and a short note each month about what happened and what we'd change.
          </dd>
        </div>
        <div>
          <dt class="text-2xl font-medium">Custom software</dt>
          <dd class="mt-3 text-lg leading-relaxed text-forest/85">
            Sometimes the thing your business runs on is a spreadsheet, a shared inbox, and one person's memory. We turn that into software: internal tools, portals for your customers, integrations between systems. Small, shipped in weeks, documented, and yours.
          </dd>
        </div>
        <div>
          <dt class="text-2xl font-medium">Consulting</dt>
          <dd class="mt-3 text-lg leading-relaxed text-forest/85">
            Advice before the money is spent. Which system to buy, whether to build instead, how to move off the old one, who to hire. Delivered as a short written plan with a price beside each option, including the option of doing nothing.
          </dd>
        </div>
      </dl>
    </section>

    <!-- A short, honest aside -->
    <section class="mx-auto max-w-3xl px-6 py-16 lg:py-20">
      <div class="border-l-4 border-sage pl-6 sm:pl-8">
        <p class="text-2xl font-medium leading-snug tracking-tight sm:text-3xl">
          We're not the cheapest, and we're not the biggest. We're the ones who'll still know your name in five years.
        </p>
        <p class="mt-4 text-forest/70">Willow takes on about ten clients at a time.</p>
      </div>
    </section>

    <!-- Questions: motion answers a click, so it's welcome -->
    <section id="questions" class="mx-auto max-w-3xl px-6 py-16 lg:py-20">
      <h2 class="text-3xl font-medium tracking-tight">Questions people ask first</h2>
      <div class="mt-8 divide-y divide-forest/20 border-y border-forest/20">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-xl font-medium marker:content-none [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="mt-1 shrink-0 text-sage transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 3v16M3 11h16" /></svg>
              </span>
            </summary>
            <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-forest/85">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="mx-auto max-w-3xl px-6 py-20 text-center lg:py-32">
      <Logo variant="mark" class="mx-auto h-20 w-auto text-forest" title="" />
      <h2 class="mt-8 text-[clamp(2rem,4.5vw,3.5rem)] font-medium leading-tight tracking-[-0.02em] text-balance">
        Tell us what's slow. We'll tell you what we'd do.
      </h2>
      <p class="mx-auto mt-5 max-w-[44ch] text-lg leading-relaxed text-forest/80">
        The first hour is free and ends with a written summary, whether or not you hire us.
      </p>
      <div class="mt-8 flex flex-col items-center gap-4">
        <a href="mailto:hello@willow.example?subject=A%20call%20with%20Willow" class="rounded-md bg-forest px-7 py-4 text-lg font-medium text-cream hover:bg-forest-deep">Book a call</a>
        <a href="mailto:hello@willow.example" class="underline decoration-sage decoration-2 underline-offset-4">hello@willow.example</a>
      </div>
    </section>
  </main>

  <footer class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-forest/70 sm:flex-row sm:items-center sm:justify-between">
    <span class="text-2xl font-medium tracking-tight text-forest">Willow</span>
    <p>Managed IT, custom software, and consulting for small companies.</p>
  </footer>
</Layout>
