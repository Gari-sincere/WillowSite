---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import GeneracUploadApp from "../components/GeneracUploadApp";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Willow — Generac upload"
  description="Upload a Generac file into Convex storage. Uploaded files are not listed or available to download."
  fonts={["Hanken+Grotesk:wght@400;500;600"]}
  bodyClass="font-hanken bg-cream text-forest antialiased"
>
  <main class="mx-auto max-w-3xl px-6 py-14 sm:px-10 lg:py-20">
    <header class="flex flex-col gap-6">
      <a href={base} class="w-fit text-forest" aria-label="Back to Willow home">
        <Logo variant="full" class="h-20 w-auto" />
      </a>
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.16em] text-forest/60">Convex storage</p>
        <h1 class="mt-2 text-3xl font-medium tracking-tight sm:text-4xl">Generac upload</h1>
        <p class="mt-3 max-w-[54ch] text-lg leading-relaxed text-forest/80">
          Choose a file and send it to Convex. Uploaded files stay stored, and this page does not list or download them.
        </p>
      </div>
    </header>

    <div class="mt-10">
      <GeneracUploadApp client:load />
    </div>
  </main>
</Layout>
