---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import HeroVideo from "../components/HeroVideo.astro";

// Tree rings: slightly off-centre circles, like a real cross-section.
const rings = [
  { r: 47, cx: 50.4, cy: 49.6, w: 0.5 },
  { r: 43.5, cx: 49.7, cy: 50.5, w: 0.35 },
  { r: 40.8, cx: 50.6, cy: 50.2, w: 0.5 },
  { r: 38.2, cx: 49.5, cy: 49.5, w: 0.3 },
  { r: 36.1, cx: 50.3, cy: 50.6, w: 0.45 },
];

const services = [
  {
    name: "Managed IT",
    body: "The everyday: laptops set up before someone's first day, a network that doesn't need restarting, email and files backed up somewhere you could actually restore from. A fixed monthly fee and the same two or three people every time you call.",
  },
  {
    name: "Custom software",
    body: "When the spreadsheet has become the business, we replace it with something that can be trusted. Internal tools, customer portals, and integrations between systems that never planned to meet. You own the code.",
  },
  {
    name: "Consulting",
    body: "Deciding what to buy, what to build, and what to leave alone. We write a plan you can hand to any other vendor and take no commission from anyone we recommend.",
  },
];

const year = [
  { when: "First month", what: "We inventory everything, fix whatever is on fire, and write down how your systems actually work, usually for the first time." },
  { when: "Months two to four", what: "The quiet work: backups tested, accounts tidied, the one integration that everyone complains about finally built." },
  { when: "Mid-year", what: "A short review. What's cost more than expected, what's saved time, what we'd stop doing." },
  { when: "The rest", what: "Support in the background. Small improvements shipped as they come up. A plan for next year that fits on a page." },
];
---

<Layout
  title="Willow — steady technology for companies that plan to be around"
  description="Managed IT, custom software, and consulting from a small technology company that measures its work in years, not tickets."
  fonts={["Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600", "Hanken+Grotesk:wght@400;500;600"]}
  bodyClass="font-hanken bg-cream text-forest antialiased"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-7 sm:px-10">
    <a href="#top" class="flex items-center gap-3" aria-label="Willow, back to top">
      <Logo variant="mark" class="h-10 w-auto text-forest" />
      <span class="font-newsreader text-2xl italic" style="font-variation-settings: 'opsz' 24">Willow</span>
    </a>
    <div class="flex items-center gap-7 text-[15px]">
      <a href="#services" class="hidden hover:underline sm:inline">What we do</a>
      <a href="#year" class="hidden hover:underline sm:inline">A year with us</a>
      <a href="#contact" class="font-medium underline decoration-sage decoration-2 underline-offset-4">Talk to us</a>
    </div>
  </nav>

  <main id="top" class="mx-auto max-w-7xl px-6 sm:px-10">
    <!-- Hero -->
    <header class="grid items-center gap-12 pb-24 pt-10 lg:grid-cols-12 lg:gap-8 lg:pb-32 lg:pt-16">
      <div class="lg:col-span-6">
        <h1
          class="font-newsreader text-[clamp(2.75rem,6.4vw,5.6rem)] font-light italic leading-[1.02] tracking-[-0.015em]"
          style="font-variation-settings: 'opsz' 72"
        >
          Steady technology for companies that plan to be around.
        </h1>
        <p class="mt-8 max-w-[44ch] text-lg leading-relaxed text-forest/85 sm:text-xl">
          Willow is a small technology company. We manage IT, build custom software, and give advice you can act on, for businesses that would rather grow a ring a year than double and split.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#contact" class="inline-flex items-center rounded-sm bg-forest px-6 py-3.5 text-[17px] font-medium text-cream hover:bg-forest-deep">Talk to us</a>
          <a href="#services" class="text-[17px] underline decoration-forest/30 underline-offset-4 hover:decoration-forest">See what we do</a>
        </div>
      </div>

      <!-- Video inside tree rings -->
      <figure class="relative mx-auto w-full max-w-[560px] lg:col-span-6 lg:max-w-none">
        <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full text-forest" aria-hidden="true" fill="none" stroke="currentColor">
          {rings.map((r) => (
            <circle cx={r.cx} cy={r.cy} r={r.r} stroke-width={r.w} stroke-opacity="0.55" />
          ))}
        </svg>
        <div class="relative aspect-square">
          <div class="absolute inset-[18%] overflow-hidden rounded-full bg-forest-deep">
            <HeroVideo class="h-full w-full scale-[1.02] object-cover" />
          </div>
        </div>
        <figcaption class="sr-only">A short film of Willow at work.</figcaption>
      </figure>
    </header>

    <!-- Services: report-style, label left / content right -->
    <section id="services" class="border-t border-forest/20 py-16 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-12">
        <h2 class="font-newsreader text-3xl italic lg:col-span-3" style="font-variation-settings: 'opsz' 36">What we do</h2>
        <div class="lg:col-span-8 lg:col-start-5">
          <p class="max-w-[58ch] text-lg leading-relaxed text-forest/85 sm:text-xl">
            Most clients use all three, in different proportions as the years go on. A new client usually starts with the IT and finds the software later.
          </p>
          <dl class="mt-12 divide-y divide-forest/20 border-t border-forest/20">
            {services.map((s) => (
              <div class="grid gap-3 py-8 sm:grid-cols-12">
                <dt class="font-newsreader text-3xl sm:col-span-4" style="font-variation-settings: 'opsz' 36">{s.name}</dt>
                <dd class="max-w-[56ch] leading-relaxed text-forest/85 sm:col-span-8 sm:text-lg">{s.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- A year with Willow: a real sequence -->
    <section id="year" class="border-t border-forest/20 py-16 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <h2 class="font-newsreader text-3xl italic" style="font-variation-settings: 'opsz' 36">A year with us</h2>
          <p class="mt-4 max-w-[28ch] leading-relaxed text-forest/70">Roughly. Every company's rings look a little different.</p>
        </div>
        <ol class="lg:col-span-8 lg:col-start-5">
          {year.map((y, i) => (
            <li class="relative grid gap-2 border-l border-forest/25 py-6 pl-8 sm:grid-cols-12 sm:gap-6">
              <span class="absolute -left-[5px] top-8 h-[9px] w-[9px] rounded-full bg-sage" aria-hidden="true"></span>
              <span class="text-sm font-medium text-forest/70 sm:col-span-3 sm:pt-0.5">{y.when}</span>
              <p class="max-w-[52ch] text-lg leading-relaxed sm:col-span-9">{y.what}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Principles -->
    <section class="border-t border-forest/20 py-16 lg:py-24">
      <div class="grid gap-8 lg:grid-cols-12">
        <h2 class="font-newsreader text-3xl italic lg:col-span-3" style="font-variation-settings: 'opsz' 36">How we stay small</h2>
        <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:col-span-8 lg:col-start-5">
          <div>
            <h3 class="text-xl font-semibold">We answer the phone.</h3>
            <p class="mt-2 leading-relaxed text-forest/85">No ticket portal between you and a person. You'll know the names of everyone who works on your systems.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold">We take on ten clients at a time.</h3>
            <p class="mt-2 leading-relaxed text-forest/85">Enough to keep the lights on, few enough to remember how each one's network is wired.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold">We don't sell hardware.</h3>
            <p class="mt-2 leading-relaxed text-forest/85">Or licences, or hosting. We'll recommend them; you buy them directly, so our advice stays ours.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold">We write things down.</h3>
            <p class="mt-2 leading-relaxed text-forest/85">Every client has a plain-language document describing their systems. If we disappeared tomorrow, your next provider could pick it up.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Contact -->
  <section id="contact" class="bg-forest text-cream">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 sm:px-10 lg:grid-cols-12 lg:items-center lg:py-28">
      <div class="lg:col-span-7">
        <h2 class="font-newsreader text-[clamp(2.4rem,5vw,4.5rem)] font-light italic leading-[1.05]" style="font-variation-settings: 'opsz' 72">
          Start with a conversation, not a contract.
        </h2>
        <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-cream/80">
          An hour, free, about what's slow and what's fragile. If we're not the right fit we'll say so and suggest who might be.
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <a href="mailto:hello@willow.example?subject=A%20conversation%20with%20Willow" class="inline-flex items-center rounded-sm bg-cream px-6 py-3.5 text-[17px] font-medium text-forest hover:bg-white">Book an hour</a>
        <p class="mt-5 text-cream/80">
          or write to <a href="mailto:hello@willow.example" class="underline decoration-sage decoration-2 underline-offset-4 hover:text-cream">hello@willow.example</a>
        </p>
      </div>
    </div>
  </section>

  <footer class="bg-forest-deep text-cream/70">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10">
      <Logo variant="full" class="h-16 w-auto text-cream" />
      <p class="text-sm">Managed IT, custom software, and consulting for small companies.</p>
    </div>
  </footer>
</Layout>
